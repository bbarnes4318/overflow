PORT=3100

# Bulkvs credentials
BULKVS_USERNAME=
BULKVS_TOKEN=

# Gateway settings
SENDER_NUMBER=
SEND_INTERVAL_MS=

# Message variation. Seeds the anthropic_api_key setting on first run only;
# after that the value in the settings table wins. Variation stays off until
# it is enabled in Gateway Settings.
ANTHROPIC_API_KEY=

# Platform superadmin, seeded on first start when no user exists. The
# superadmin belongs to no tenant and creates tenants, their owners and their
# numbers. Leave the password blank and one is generated and printed once, to
# the server log, at first boot.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Recruiting inquiries from netenroll.com/aca-agent-recruiting are stored in
# the database and emailed here. Leave the address blank and they are only
# stored. SMTP is implicit TLS (port 465) with a username and password.
RECRUITING_INQUIRY_EMAIL=
# Agency Planner leads; falls back to RECRUITING_INQUIRY_EMAIL
PLANNER_LEAD_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
