# Overflow Calls Messaging — SMS gateway and conversation dashboard.
#
# Installed by deploy.sh to /etc/systemd/system/overflow-messaging.service.
#
# SMS_DB_PATH deliberately points OUTSIDE the git clone. A deploy does a
# `git pull --ff-only` (and a clone on first run) inside /opt/overflow; a
# database living in there would be one bad checkout away from destruction.
# /var/lib is where mutable service state belongs on a Debian/Ubuntu box.
[Unit]
Description=Overflow Calls Messaging
Documentation=https://github.com/bbarnes4318/overflow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/overflow/messaging
ExecStart=/usr/bin/env node server.js
Restart=always
RestartSec=3

Environment=NODE_ENV=production
Environment=PORT=3100
Environment=SMS_DB_PATH=/var/lib/overflow-messaging/database.sqlite

# The superadmin password is NOT set here. On first boot with no users the app
# generates one and prints it to the journal exactly once. Read it with:
#   journalctl -u overflow-messaging | grep -A3 'Seeded superadmin'
# Carrier credentials are entered through Gateway Settings, not baked in.
EnvironmentFile=-/etc/overflow-messaging.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=overflow-messaging

# Modest hardening. The service needs to write only its own state directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/overflow-messaging

[Install]
WantedBy=multi-user.target
